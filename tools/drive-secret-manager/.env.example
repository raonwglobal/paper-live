# Never commit real values. Set these in the host secret manager/environment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-bytes
COOKIE_SECURE=false

# Existing paper-live encrypted Google Drive secret store
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_SECRET_KEY=
GOOGLE_DRIVE_SECRET_FILE_ID=
GOOGLE_DRIVE_SECRET_FOLDER_ID=
GOOGLE_DRIVE_SECRET_DRIVE_ID=
